#!/usr/bin/env bash
# Antes de enviar: typecheck, suíte inteira (PGlite, ~3 min; inclui domínio, OpenAPI em dia e CLIs), testes dos scripts e build.
# Pular uma vez: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. .githooks/_comum.sh

ZERO=0000000000000000000000000000000000000000
mudou_codigo=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                         # apagando branch remota
  base="$remote_sha"
  if [ "$base" = "$ZERO" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"   # branch nova: compara com a main
  fi
  if [ -z "$base" ]; then mudou_codigo=1; break; fi              # sem base confiável: roda tudo
  if ! git diff --name-only "$base" "$local_sha" | so_documentacao; then mudou_codigo=1; break; fi
done
if [ "$mudou_codigo" = 0 ]; then
  echo "pre-push: só documentação, nada a verificar"
  exit 0
fi

echo "pre-push: typecheck, suíte (~3 min), scripts e build"
npm run --silent typecheck
npm test --silent
npm run --silent test:scripts
npm run --silent build
echo "pre-push: ok"
