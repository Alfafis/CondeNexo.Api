#!/usr/bin/env bash
# Rápido (segundos): só o typecheck. Não há pre-push nem testes no CI (decisão de 2026-11-01): rode `npm test` à mão,
# quando quiser validar. O build da imagem na VPS compila com tsc e volta a versão anterior se falhar.
# Pular uma vez: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. .githooks/_comum.sh

if git diff --cached --name-only | so_documentacao; then
  exit 0
fi
echo "pre-commit: typecheck"
npm run --silent typecheck
